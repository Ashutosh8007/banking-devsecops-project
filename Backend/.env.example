# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# JWT signing secret
JWT_SECRET=your_jwt_secret

# Allowed CORS origins (comma-separated)
CORS_DOMAINS=http://localhost:5173,https://yourdomain.com

# SECURITY: Set to "true" ONLY during initial owner bootstrap.
# Must be false/unset in production at all other times.
ALLOW_OWNER_BOOTSTRAP=false
